# ── 通用（所有脚本） ──
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── excel_image_review.py 专用 ──
# 仅使用上述 OPENAI_* 变量

# ── analyze_excel.py / review_audit_findings.py 额外支持（优先级从高到低） ──
# API Key:  CHECKER_API_KEY > LLM_API_KEY > API_KEY > DASHSCOPE_API_KEY > OPENAI_API_KEY
# Base URL: CHECKER_API_BASE_URL > LLM_API_BASE_URL > API_BASE_URL > OPENAI_BASE_URL > BASE_URL
# Model:    CHECKER_MODEL > LLM_MODEL > MODEL > OPENAI_MODEL

# 超时/限制（可选）
# LLM_TIMEOUT=90
# LLM_EVIDENCE_STEPS_MAX_ITEMS=30
